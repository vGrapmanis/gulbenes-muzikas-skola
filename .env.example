# Supabase — copy from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare R2 — for local dev (S3-compatible API)
# In production, the Worker uses the R2 binding instead (no keys needed)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=gms-media-dev

# Public base URL for R2 media (custom domain on the bucket)
# Local: point to a dev bucket URL or use the r2.dev subdomain
NEXT_PUBLIC_MEDIA_BASE_URL=/api/media
